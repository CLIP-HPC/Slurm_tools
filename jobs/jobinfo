    value = 'z'
    for line in jobstate:
        item = line[fieldname]
        if debug:
            print('{}: {}'.format(line['JobID'], item))
        if item != '':
           value = min(item, value)
    if str(value).lower() == 'unknown':
       value = missing_data
    if debug:
        print('Returning: {}'.format(value))
    return value

